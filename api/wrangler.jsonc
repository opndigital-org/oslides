{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oslides-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_URL": "https://oslides.opndigital.org",
    "API_URL": "https://oslides-api.opndigital.org",
    "COOKIE_SECURE": "true"
  }
}