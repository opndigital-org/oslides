
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oslides-app",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "API_URL": "https://oslides-api.opndigital.org",
  },
  "previews": {
    "vars": {
      "API_URL": "https://oslides-api.andrea-melissa-rodrigues.workers.dev",
    }
  }
}
